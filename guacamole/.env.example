# PostgreSQL password for the Guacamole database
GUAC_POSTGRES_PASSWORD=changeme

# Keycloak OIDC — must match your realm's issuer URL (same value as in rdpgw/.env)
OIDC_ISSUER=https://auth.anjoscode.com/realms/anjoscode

# Client ID and secret of the 'guacamole' client you created in Keycloak
GUAC_OIDC_CLIENT_ID=guacamole
GUAC_OIDC_CLIENT_SECRET=changeme

# The URL Keycloak redirects back to after login (must be in Keycloak's allowed redirect URIs)
GUACAMOLE_REDIRECT_URI=https://<your-guac-hostname>/guacamole/

# Local port to expose the Guacamole web UI on (proxied via Cloudflare Tunnel)
GUACAMOLE_PORT=18888
